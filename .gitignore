.playwright-mcp/
node_modules/
dist/
*.tsbuildinfo
# .claude/ 不整個排除——排除整個目錄的話，底下的 ! 例外會失效（git 不進已排除的目錄）。
# skills 是共用資產要進版控，只排除個人設定。
.claude/settings.json
.claude/settings.local.json

# Database & uploads
data/

# Environment
.env
.env.local

# AI Context runtime events (contracts are kept)
.ai_context/events/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Build
web/dist/
server/dist/
shared/dist/

# Logs
*.log

# Test scripts with credentials
test-*.js
test-*.mjs
test-*.ps1

# Ad-hoc debug scripts (underscore prefix convention)
_*.cjs
_*.mjs
server/_*.cjs
server/_*.mjs

# npm lockfile (this repo uses pnpm)
package-lock.json

# docs/* (not docs/) — an excluded parent directory cannot have children re-included,
# so the entries are ignored individually and the kept ones negated below.
docs/*
!docs/archive/
!docs/操作手冊.md
!docs/功能說明.md
# axure-snapshots: keep the crawler script tracked; generated snapshot HTML/images stay ignored
!docs/axure-snapshots/
docs/axure-snapshots/*
!docs/axure-snapshots/crawl-axure.mjs
*.zip

# Jev MCP 獨立版打包產物（pnpm build:jev-mcp 產生）
packages/jev-mcp/release/
