# AI-OmniCommander Environment Configuration
# Copy this file to .env and modify as needed

# Claude CLI path: "auto" = auto-detect via `which claude`, or specify full path
CLAUDE_PATH=auto

# Server port
PORT=3456

# SQLite database path (relative to project root)
DB_PATH=./data/omni.db

# Default Claude model for agents
DEFAULT_MODEL=sonnet

# Max budget per agent (USD), 0 = unlimited
MAX_AGENT_BUDGET_USD=0

# Log level: debug, info, warn, error
LOG_LEVEL=info
